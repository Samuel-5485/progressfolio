# --- Supabase ---
# Project Settings -> API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Project Settings -> API -> service_role secret. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- GitHub OAuth App (github.com/settings/developers) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Random secret used to verify GitHub webhook payloads
GITHUB_WEBHOOK_SECRET=

# --- AI: Google Gemini (locked to Flash-Lite, do not switch providers) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Rolling alias that always points to the latest Flash-Lite release.
# Pin to a fixed version (e.g. gemini-3.1-flash-lite) if you need stable behavior.
GEMINI_MODEL=gemini-flash-lite-latest

# --- App ---
# Public base URL of the deployed app (used for OAuth callbacks and share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
